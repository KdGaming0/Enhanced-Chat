{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "A quality-of-life chat upgrade for Hypixel SkyBlock and general use.\nAdds better formatting, search, filtering, and other small improvements.",
  "authors": [
    "Kd_Gaming1"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/enhanced-chat",
    "sources": "https://github.com/kdgaming0/Enhanced-Chat"
  },
  "license": "GPL-3.0-only",
  "icon": "assets/enhanced_chat/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.github.kdgaming0.enhancedchat.EnhancedChat"
    ]
  },
  "mixins": [
    "enhancedchat.mixins.json"
  ],
  "accessWidener": "enhancedchat.ct",
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft}",
    "fabric-api": "*",
    "midnightlib": ">=1.9.3"
  }
}
